<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 0: halo ring (full circle in light_purple) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/light_purple" />
        </shape>
    </item>

    <!-- Layer 1: button face (dark_blue circle, inset to leave ring visible) -->
    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/dark_blue" />
        </shape>
    </item>

</layer-list>